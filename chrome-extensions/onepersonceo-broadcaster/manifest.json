{
  "manifest_version": 3,
  "name": "OnePersonCEO Knowledge Broadcaster",
  "version": "2.3.0",
  "description": "ระบบ CDP, RFM/RSV Multi-Step Follow-up Workflow & Broadcaster เฉพาะเพจ OnePersonCEO (เสวิญ) — เชื่อม Meta Graph API, Turbo Direct, เวลาทองรายบุคคล และซิงก์ HealthScale Server",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "https://www.facebook.com/*",
    "https://upload.facebook.com/*",
    "https://graph.facebook.com/*",
    "https://dashboard.aimar.cloud/*",
    "https://onepersonceo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "เปิด OnePersonCEO Smart Broadcaster v2.3",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}